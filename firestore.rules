rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================
    // HELPER FUNCTIONS
    // ====================================================

    // 1. Check if the user is listed in the league's 'admins' array
    function isLeagueAdmin(leagueId) {
      let leagueDoc = get(/databases/$(database)/documents/leagues/$(leagueId));
      return request.auth != null &&
             request.auth.uid in leagueDoc.data.admins;
    }

    // 2. App-wide admin
    function isAppAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 3. Legacy bad status values (mdi:* icon names stored as `status`, at
    // one point) needed a one-off migration tool to clean up. Constrain any
    // write that touches `status` to the canonical set so that can't recur;
    // null/absent (a still-live, unscored event) is also valid.
    function isValidEventStatus() {
      let status = request.resource.data.get('status', null);
      return status == null || status in ['complete', 'rain', 'handicap', 'practice', 'canceled'];
    }

    // ====================================================
    // COLLECTION RULES
    // ====================================================

    // 1. LEAGUES & CALENDAR
    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if false;

      // The league's own admins can edit/delete it
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.admins;

      // Announcements Subcollection
      match /announcements/{announcementId} {
        allow read: if true; // Allows all players to see the history
        allow write: if isLeagueAdmin(leagueId);
      }
    }

    match /{path=**}/calendar/{entryId} {
      allow read: if true;
      allow create, update: if isLeagueAdmin(path[1]) && isValidEventStatus();
      allow delete: if isLeagueAdmin(path[1]);
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isLeagueAdmin(request.resource.data.leagueId) && isValidEventStatus();
      allow delete: if isLeagueAdmin(resource.data.leagueId);
    }

    // Urgent alerts 
    match /alerts/{alertId} {
      allow read: if true;
      allow create: if isLeagueAdmin(request.resource.data.leagueId);
      allow delete: if isLeagueAdmin(resource.data.leagueId) || isAppAdmin();
    }

    // 2. COURSES & TEES (shared across leagues, not league-scoped)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAppAdmin();

      match /tees/{teeId} {
        allow read: if true;
        allow write: if isAppAdmin();
      }
    }

    // 3. PLAYERS
    match /players/{playerId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAppAdmin();
    }

    // 4. LIVE ROUNDS
    match /live_rounds/{roundId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // 5. ARCHIVED ROUNDS
    match /{path=**}/rounds/{roundId} {
      allow read: if true;
      allow create: if (request.auth != null && request.resource.data.get('type', '') == 'casual') ||
        (request.resource.data.get('leagueId', '') != '' && isLeagueAdmin(request.resource.data.leagueId)) ||
        isAppAdmin();
      allow update, delete: if (resource.data.get('leagueId', '') != '' && isLeagueAdmin(resource.data.leagueId)) ||
        isAppAdmin();
    }
  }
}
