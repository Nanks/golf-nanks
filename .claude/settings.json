{
  "permissions": {
    "allow": [
      "Bash(netstat -ano)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://localhost:3001/)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" \"http://[::1]:3001/\")",
      "Bash(awk '{print $5}')",
      "Bash(xargs -r -I{} taskkill //F //PID {})",
      "Bash(timeout 30 bash -c 'until curl -sf http://localhost:3001 >/dev/null 2>&1; do sleep 1; done')"
    ]
  }
}
